{
  "manifest_version": 3,
  "name": "BackLinkSourceBot · 外链翻页导出",
  "version": "2.0.3",
  "description": "Semrush / 3ue 反向链接：每页导出 + 翻页，自动选中含表格的 iframe",
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "*://*.3ue.co/*",
    "*://sem.3ue.co/*",
    "*://*.semrush.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BackLinkSourceBot",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.3ue.co/*",
        "*://*.semrush.com/*"
      ],
      "js": [
        "content-frames.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.3ue.co/*",
        "*://*.semrush.com/*"
      ],
      "js": [
        "content-panel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
